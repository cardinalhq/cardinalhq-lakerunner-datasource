{
  "name": "cardinalhq-lakerunner-datasource",
  "version": "2.5.0",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "npm run license:check && jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "_sign": "TODO: Re-enable when publishing to Grafana catalog: npx --yes @grafana/sign-plugin@latest",
    "license:install": "./scripts/install-license-tools.sh",
    "license:check": "./scripts/install-license-tools.sh && ./bin/license-eye header check",
    "license:fix": "./scripts/install-license-tools.sh && ./bin/license-eye header fix",
    "sign": "npx --yes @grafana/sign-plugin@latest"
  },
  "author": "Cardinal HQ",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@grafana/eslint-config": "^9.0.0",
